diff --git a/.github/workflows/rust-verify.yml b/.github/workflows/rust-verify.yml
new file mode 100644
index 0000000..e618f6b
--- /dev/null
+++ b/.github/workflows/rust-verify.yml
@@ -0,0 +1,208 @@
+---
+# ══════════════════════════════════════════════════════════════════════════
+# Rust Verify — fast, single-job compile/lint/test gate.
+#
+# Purpose: give a single, quick, authoritative answer to "does the whole
+# Rust workspace build, lint and test cleanly?" without waiting on the
+# multi-job pipelines. Runs on every branch push and on demand.
+# ══════════════════════════════════════════════════════════════════════════
+name: Rust Verify
+
+'on':
+  push:
+    branches: ["**"]
+  pull_request:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: rust-verify-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  verify:
+    name: fmt + clippy + test + bins
+    runs-on: ubuntu-latest
+    timeout-minutes: 40
+
+    steps:
+      - uses: actions/checkout@v5
+
+      - name: Set up Rust
+        uses: dtolnay/rust-toolchain@stable
+        with:
+          components: rustfmt, clippy
+
+      - name: Restore Rust cache
+        uses: Swatinem/rust-cache@v2
+
+      - name: cargo fmt --check
+        run: cargo fmt --all -- --check
+
+      - name: cargo clippy (deny warnings)
+        run: cargo clippy --workspace --all-targets -- -D warnings
+
+      - name: cargo test --workspace
+        run: cargo test --workspace
+
+      - name: cargo build --bins
+        run: cargo build --bins
+
+      - name: Smoke-run every pipeline binary
+        shell: bash
+        run: |
+          set -euo pipefail
+          mkdir -p data export docs bridge
+          echo "--- self_heal ---"
+          cargo run --quiet --bin self_heal -- --heal
+          echo "--- pipeline --list ---"
+          cargo run --quiet --bin pipeline -- --list
+          echo "--- bridge_intelligence ---"
+          cargo run --quiet --bin bridge_intelligence -- \
+            --input bridge/iran_results.json --censorship-level auto
+          echo "--- pipeline --all ---"
+          cargo run --quiet --bin pipeline -- --all \
+            --input bridge/iran_results.json \
+            --report data/pipeline_report.json
+          echo "--- auto_debug ---"
+          cargo run --quiet --bin auto_debug -- rust-verify "${GITHUB_RUN_ID}"
+          echo "--- report ---"
+          cat data/pipeline_report.json
+
+      - name: Assert no pipeline stage failed
+        shell: bash
+        run: |
+          set -euo pipefail
+          FAILED=$(jq -r '.summary.failed' data/pipeline_report.json)
+          OK=$(jq -r '.summary.ok' data/pipeline_report.json)
+          SKIPPED=$(jq -r '.summary.skipped' data/pipeline_report.json)
+          echo "ok=${OK} skipped=${SKIPPED} failed=${FAILED}"
+          if [ "${FAILED}" -ne 0 ]; then
+            jq -r '.stages[] | select(.status == "failed")
+              | "::error::stage \(.stage): \(.detail.error)"' \
+              data/pipeline_report.json
+            exit 1
+          fi
+
+      - name: Upload verification artefacts
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: rust-verify-artifacts
+          path: |
+            data/pipeline_report.json
+            data/auto_debug_report.json
+            diagnostics/rust-self-heal.json
+          retention-days: 7
+          if-no-files-found: warn
+
+  cross-compile:
+    name: Cross-compile check (armv7 musl)
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+
+    steps:
+      - uses: actions/checkout@v5
+
+      - name: Set up Rust
+        uses: dtolnay/rust-toolchain@stable
+
+      - name: Restore Rust cache
+        uses: Swatinem/rust-cache@v2
+
+      - name: Add ARMv7 target
+        run: rustup target add armv7-unknown-linux-musleabihf
+
+      # `cargo check` never invokes the linker, so no `cross`/Docker/C
+      # toolchain is required — this is what fixed the exit-127 failure in
+      # the Zero-Error Enterprise CI cross-compile job.
+      - name: cargo check (armv7)
+        run: >
+          cargo check --target armv7-unknown-linux-musleabihf
+          --workspace --all-targets --release
+
+  go-and-zig:
+    name: Go + Zig verification
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+
+    steps:
+      - uses: actions/checkout@v5
+
+      - uses: actions/setup-go@v6
+        with:
+          go-version-file: go.work
+          cache: true
+
+      - name: go build / vet / test
+        run: |
+          set -euo pipefail
+          go build ./...
+          go vet ./...
+          go test ./...
+
+      - name: Set up Zig
+        uses: mlugg/setup-zig@v2
+        with:
+          version: 0.14.1
+
+      - name: Build zig-scanner
+        working-directory: zig-scanner
+        run: zig build -Doptimize=ReleaseFast
+
+  lint-everything:
+    name: Shell + YAML + Actions lint
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+
+    steps:
+      - uses: actions/checkout@v5
+
+      - uses: actions/setup-python@v6
+        with:
+          python-version: '3.12'
+
+      - name: Install linters
+        run: |
+          set -euo pipefail
+          pip install --quiet yamllint
+          sudo apt-get update -qq
+          sudo apt-get install -y --no-install-recommends shellcheck
+
+      - name: shellcheck + bash -n
+        shell: bash
+        run: |
+          set -euo pipefail
+          rc=0
+          while IFS= read -r -d '' f; do
+            bash -n "$f" || rc=1
+            shellcheck -S warning "$f" || rc=1
+          done < <(find . -name '*.sh' -not -path './.git/*' -print0 | sort -z)
+          exit "$rc"
+
+      - name: yamllint
+        run: yamllint -c .yamllint .github/
+
+      - name: actionlint
+        uses: docker://rhysd/actionlint:latest
+        with:
+          args: -color
+
+      - name: Migration invariant — zero Python sources
+        shell: bash
+        run: |
+          set -euo pipefail
+          mapfile -t found < <(
+            find . -name '*.py' \
+              -not -path './.git/*' \
+              -not -path './target/*' \
+              -not -path './vendor/*' \
+              -print
+          )
+          if [ "${#found[@]}" -gt 0 ]; then
+            printf '::error::Python file reintroduced: %s\n' "${found[@]}"
+            exit 1
+          fi
+          echo "OK — 0 Python source files"
