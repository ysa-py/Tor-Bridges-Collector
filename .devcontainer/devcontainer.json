{
  "name": "Pro OpenCode Environment",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "secrets": {
    "CLOUDFLARE_ACCOUNT_ID": { "description": "CF Account" },
    "CLOUDFLARE_GATEWAY_ID": { "description": "CF Gateway" },
    "CLOUDFLARE_API_TOKEN": { "description": "CF Token" }
  },
  "postCreateCommand": "curl -fsSL https://opencode.ai/install | bash",
  "remoteEnv": {
    "CLOUDFLARE_ACCOUNT_ID": "${localEnv:CLOUDFLARE_ACCOUNT_ID}",
    "CLOUDFLARE_GATEWAY_ID": "${localEnv:CLOUDFLARE_GATEWAY_ID}",
    "CLOUDFLARE_API_TOKEN": "${localEnv:CLOUDFLARE_API_TOKEN}"
  }
}
