diff --git a/.github/workflows/self-heal.yml b/.github/workflows/self-heal.yml
index b8a170f..fcd43c3 100644
--- a/.github/workflows/self-heal.yml
+++ b/.github/workflows/self-heal.yml
@@ -1,30 +1,72 @@
 name: Self-Heal and Diagnostics
 
+# Incident #73 / Exit 127 resolution:
+# The legacy version of this workflow invoked a *hardcoded* `powershell`
+# binary on an `ubuntu-latest` runner. `powershell` (Windows PowerShell) is
+# NOT installed on GitHub's Linux runners — only `pwsh` (PowerShell Core) is,
+# and even that is not relied upon here. The hardcoded `powershell` call
+# therefore exited with **127 (command not found)** on every scheduled run.
+#
+# This file now drives the diagnostics through the POSIX-native
+# `scripts/self_heal.sh` (a faithful bash port of `scripts/self_heal.ps1`
+# that runs cargo fmt / clippy / audit / test and writes deterministic
+# diagnostics under diagnostics/<timestamp>/). Zero `powershell`/`pwsh`
+# invocations remain on any Linux runner. See MIGRATION_STATUS.md.
+
 on:
   workflow_run:
     workflows: ["Zero-Error Enterprise CI"]
     types: [completed]
   schedule:
     - cron: '0 */6 * * *'  # every 6 hours
+  workflow_dispatch:
   push:
     branches: ["main", "master"]
 
+permissions:
+  contents: read
+  actions: read
+
+concurrency:
+  group: self-heal-${{ github.ref }}
+  cancel-in-progress: false
+
 jobs:
   run-self-heal:
     runs-on: ubuntu-latest
     if: github.event_name != 'workflow_run' || (github.event.workflow_run.conclusion == 'failure')
+    timeout-minutes: 30
     steps:
       - name: Checkout
         uses: actions/checkout@v4
 
-      - name: Ensure PowerShell self-heal script is present
-        run: |
-          powershell -NoProfile -Command "Test-Path .\\scripts\\self_heal.ps1 -PathType Leaf -or Write-Error 'Missing self_heal.ps1'"
+      - name: Set up Rust toolchain (fmt + clippy for diagnostics)
+        uses: dtolnay/rust-toolchain@stable
+        with:
+          components: rustfmt, clippy
 
-      - name: Run self-heal diagnostics (PowerShell)
+      - name: Install cargo-audit (so the diagnostics include a vuln scan)
+        uses: cargo-bins/cargo-binstall@main
+        with:
+          args: cargo-audit -y
+
+      - name: Ensure POSIX self-heal script is present and executable
+        shell: bash
         run: |
-          powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\self_heal.ps1
+          set -euo pipefail
+          if [ ! -f scripts/self_heal.sh ]; then
+            echo "::error::Missing scripts/self_heal.sh"
+            exit 1
+          fi
+          chmod +x scripts/self_heal.sh
+          echo "✔ scripts/self_heal.sh present (POSIX-native, no powershell)"
+
+      - name: Run self-heal diagnostics (POSIX bash)
+        shell: bash
         continue-on-error: true
+        run: |
+          set -euo pipefail
+          bash scripts/self_heal.sh
 
       - name: Collect diagnostics artifacts
         if: always()
@@ -32,4 +74,5 @@ jobs:
         with:
           name: self-heal-diagnostics
           path: diagnostics/
+          if-no-files-found: ignore
           retention-days: 7
